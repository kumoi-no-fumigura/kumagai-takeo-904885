 "blocks": [
  {
   "id": "kumagai-takeo-904885-0001",
   "pid": "904885",
   "pages": [
    12
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "大正四年(六月迠)",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0002",
   "pid": "904885",
   "pages": [
    13
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "さみしさに耐へつゝけふも山やけのひびき間近くわれすまひけりいつとなく雜木原より外山よりとつぷりくれぬ春の長日は",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0003",
   "pid": "904885",
   "pages": [
    14
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "叉手くむと近き山根のすゞ原にすゞ刈ればひるの鳩なけりけり畑のすみいくつも小さき坪きりて南瓜の床をつくりけるかも春の陽のあたゝかきうねに種芋を一つ一つにならべ行くかなうねの土かぶせむとする種芋の芽をふけり小さき紫の芽を",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0004",
   "pid": "904885",
   "pages": [
    15
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "すぐろなる山の燒樹にもず鳴けば春のまひるのうら悲しもよもずがねのきこゆる外は四五本の燒樹ばかりのひるの野平春陽暈萱草のかげにぐつすりと此孕猫ねむり居るかもくれのこる彼山の端のあかるみへ向ひてとべるもずの高鳴き",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0005",
   "pid": "904885",
   "pages": [
    16
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "春山をくれば名しらぬ雜木のわかめのしんの眞赤なるかも春じめる山の朽木の椎茸をとらむとよれば香の悲しもよすぐろなる野中にのこるからす麥朝雨にぬれて光る悲しもわれしらずむしりし野路のからす麥すてのこしたり青き一莖",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0006",
   "pid": "904885",
   "pages": [
    17
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "刈安のわかめのかげにしととゐてさえづりあかぬ山のくれの陽青麥の中にわれたつ掌に麥奴の穗の粉のつきしまゝ矮鷄のなく田舎のひるのまはり路此旅人は一人なりけり春川の清き淺瀨に蠶莚を洗ふ女の脛しろきかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0007",
   "pid": "904885",
   "pages": [
    18
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "砂川の淺瀨をくだる魚の背のきらと光りて水はねにけり山桑のほぐれもはてぬ芽はいつか霜やけて黑くくさりけるかも春山の芽ばえ忘れし雜木にきつゝきのゐてなかぬ晝かな山上の卯月の木かげかたくりの花の小さく咲く大牟呂峰",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0008",
   "pid": "904885",
   "pages": [
    19
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "我が妻が乳房炎にやめる日を通草は雨にちりはじめけり古茅の根株の中にやゝ青くもゆるすゝきの芽の悲しもよ赤にごる出水の芥追ひ追ひてつばくらは低く川下へ飛ぶ×朝の床父と相寢て父にのみわかるはなしを我が乳兒はいふ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0009",
   "pid": "904885",
   "pages": [
    20
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "青みゆく雪解川の川下に河原に誰ぞや古草を燒く雪どけの海手のかたゆまづ見ゆる山燒けの夜となれば悲しも夜のかなた月代よりもほのかなる遠山やけのうらさみしさよ夜の山の山火赤きにまはだかの心まともに向ひてあらしめ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0010",
   "pid": "904885",
   "pages": [
    21
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "我が胞をうづめしといふ樹のもとに眸とぢて立てるうらさみしさよ悲みのはてに神見ず我れを見ず只一點の眸に赤き火麥ふめる女の彼方風海にときをりきらと波光るみゆ伯母がため春のひがんの菩提寺の鐘を撞きわれ撞きにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0011",
   "pid": "904885",
   "pages": [
    22
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山石の野づらを黑き蜘蛛這へば夕の心くらくなりにけり畠のすみかまどつくりて鮫膓を煑るけむりの上を橫ぎれる鳥夜に入りて漸くはれし庭のすみぬれし眞竹の葉の光り見る春山の花さく彌生手弱女の乳癌の乳房くさりゆくかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0012",
   "pid": "904885",
   "pages": [
    23
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "乳癌の乳房くされば手弱女は黑髪なげて彌生を寢たり乳癌の乳房くされば悲しげに手弱女見入る草花たねの床久に病む汝が針さしの縫針の赤さびにつゝ冬ふけにけり魚の瞳と我が瞳とあひし水面にかなしや冬の黄なる落日",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0013",
   "pid": "904885",
   "pages": [
    24
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "親しらぬ箱の仔兎さむき夜をひとりわびねてなかぬ仔兎薄月の霜夜のかげをかたしきて野犬がねむる小屋ののきばに童謠の上に夕陽のあか〳〵とてらへば一人泣きたくなれり雪山のみねよりみねへふきつくる嵐の上の黄なる日輪",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0014",
   "pid": "904885",
   "pages": [
    25
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "大空や夜風と夜風打ちふれて冬の大地にふきおつる音土方等が荒太繩に木畚あむ新墾小屋のさむき冬の日太繩の木畚のあらき目をふける朝風さむし冬のにひばり古家の灯のとゞかざる夜のすみのうすくらがりに光る水甕",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0015",
   "pid": "904885",
   "pages": [
    26
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "くろ〳〵と釘ぞとがれる古家の煤光りする太き柱に冬の月木かげと木かげかさなりて地にうすくろき山路をふむぷつつりと黃なる疊につきとほす疊屋が針の大きなるかもぽつねんとひとりすまひのをんどりの尾をたれて鳥屋にねむる悲しも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0016",
   "pid": "904885",
   "pages": [
    27
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "鏘々と風燒空の下に鳴る友ずれわたる青眞竹原七草の粥煑んわか木迎へにと幣を手にして春山を行く我がまゝを汝にとほさせて夕濱のまはり路をば歩みてありき風上の山の高嶺に雪けむり立つ日は母と峽にこもれる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0017",
   "pid": "904885",
   "pages": [
    28
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "父がためとろろ汁すと雪解する春山のかげに山芋を堀る伏し柴に枯れし芋蔓ところ蔓はひもとほろふ山は悲しもうづくまり伏し柴のもとに芋ほると土かき出だす掌のまくろさよ黄粉餅天ざかる鄙の朝寒に子が名付親おもふなりけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0018",
   "pid": "904885",
   "pages": [
    29
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "水色の山遠けむり野邊けむり雪解の國に天つ雨降る山少女野老堀るとよいむれゆくむれのしりへの頰赤の少女雪どけの山邊はよろし山少女あからをとめら野老ほるかも春の陽は黄の若草にあたゝかく孕み雀の背にあたゝかく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0019",
   "pid": "904885",
   "pages": [
    30
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うすくさす夕陽の中の黄の山よ顏よせて汝と泣きたかりけり放鳥の林に急ぐよろこびもおもひぬ君に逢ひに行く身はかくれなく一樹のかげのなつかしさ黄葉とびつくす夕月夜山うす黄なる入陽の山へなきにゆく鳥見れば妻も子も忘れけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0020",
   "pid": "904885",
   "pages": [
    31
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "芹川の杭にとまりてみそさゞいなきぬ遠人おもふ冬の日霜夜空我が掌ふりつる汝が乳房白きをおもふこの霜夜空うなだれて何を憂ふる日輪はわれより燃えて天ゆくならずや我が乳兒に尿をさせつゝながめやる冬の朝陽の中の裸木",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0021",
   "pid": "904885",
   "pages": [
    32
   ],
   "no": null,
   "maki": "大正四年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "太針は老いたる母が小さきわげに光りて冬の夜ぞふけにけるはだれ雪母はかよわの身を忘れかや刈る山の子をおもふらむ涙もつものゝ限りよ安んじて涙をおとせ落日の國物とへば楮の皮をはぎながらわれを見る瞳の光る山人",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0022",
   "pid": "904885",
   "pages": [
    33
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "汝が摘む彼夕濱の冬草の波にぬれなばわれおもひてよ大正三年",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0023",
   "pid": "904885",
   "pages": [
    34
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山草の黃ばみ行くとも汝が乳房おさへて太息人に知らゆな×紫に通草の熟るゝ山國とかりそめにだにせめて來たまへ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0024",
   "pid": "904885",
   "pages": [
    35
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ものおもひせまじとすれど山草のいつしか黃ばみ散るにあらずや×いち早く峽に黃ばめるわかき木を見まもるに生命つかれけるかな一人旅人の子の親の一人旅赤にごる空黃なる國原他國の黃ばむ山路にふりかへり彼旅人も見入りけらずや",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0025",
   "pid": "904885",
   "pages": [
    36
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "旅人にあらずとするも山草の黃ばめる上の雲雀なるものこはひばりなになくひばり黃なる草ふむも悲しき此一人旅我が汽車の窓にむかひて稻村のかげより笑める栗原少女×おそ秋の街のはたごの裏庭に我が爲め黃ばむ樹かとなげかゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0026",
   "pid": "904885",
   "pages": [
    37
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黃なる山てりかへす陽が小さなる金の十字架に悲しからずや山村暮鳥氏に×おはぐろの女の國にわが妻の白き前齒もうらさみしさようす闇に光る夜の川、川端を額たれゆくは人の子の親一つぶの掌の籾の皮むけば水晶に似し米の悲しや",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0027",
   "pid": "904885",
   "pages": [
    38
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "我が肩に銀杏の黃葉の散りて來よ尼院へといま憂ひて歩むに翅鳴らし飛ぶは何鳥心なく黃草の上をとぶは何鳥おそ秋の山に向ひて我が淚おとすまもなし乳兒可愛ゆさにぐつすりと乳兒は寢入りてめざめざり青萱山に雨わたれども",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0028",
   "pid": "904885",
   "pages": [
    39
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "秋の崖夕うす黃いの土くれのくづれに螻姑はなきいでにけりひとつひとつ青豆柿を打ちつぶし澁汁つくる日のうら悲しさよ秋ふかき沼澤のしめり土を這ふゐもりのくろき背もまさびしや利鎌の刄草叢の中の尖り石かちりとかめば火は走りけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0029",
   "pid": "904885",
   "pages": [
    40
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "おそ秋のしめらへる畑の土ふみて大麥の種子を一人まきにけりうす黃なる大麥の種子を掌に握りおそ秋の畑に立てば悲しもかし鳥は來鳴かず秋の板敷のつめたさ感じねころびてありおそ秋の黃なる陽がふるくつきりと大根がしろくぬけいづる畑",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0030",
   "pid": "904885",
   "pages": [
    41
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "我がよれる野木灰白の木の肌にしみとほるまで降れ秋の雨×秋來たる子がはじめての秋來たるいとほしむ父がうるむ瞳よりあかつきの天にせまりて青山は遠く聳えぬ秋來たるらし無花果の青き實さけておちぬれば子がはじめての秋は悲しも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0031",
   "pid": "904885",
   "pages": [
    42
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "名もしらぬ庭草の花もなつかしや子がはじめての秋にさければうす赤く匂ひいでつもはじめての我が子が秋にさく草の花秋來たる北陸前の草の戶のからたちの實は濃青なるまゝ他國の麥打唄の悲しきに旅人は淚おとしてすぎぬる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0032",
   "pid": "904885",
   "pages": [
    43
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "淚おとしすぎんとするか路はたの煙草の花のうす黃なりとてはたごやの二階のわれに向日葵は黃の大輪をむけてさきつも北上の曠野流るゝ濁流にわがわたし舟こぎいでにけり北上のわたしわたれば今更に旅人なりしおどろきをする",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0033",
   "pid": "904885",
   "pages": [
    44
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黃の子馬いばゆる前にたう〳〵と北上の流にごりて行くかも路の邊の桔梗の花も旅なればたはやすく見てすぎかねにけり馬の子の小さきひづめの跡かなし秋の岩手の高草の路秋の路ひろきが中を土いきれひたに感じて旅人行くも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0034",
   "pid": "904885",
   "pages": [
    45
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黄に濁る阿武隅越えて旅人は秋の磐城の國に入るかもあぢさゐの水色の花むらがりてさける山邊に忍びてあるかも心いたみ鄙の長路の草いきれかぎつゝ行けば悲しや白日山百合の花さく國に黑髪を忘るる從妹夫あらずけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0035",
   "pid": "904885",
   "pages": [
    46
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "梧桐の葉の散る家にくろ髪を忘れて夫もなき從妹すむ朝月の光悲しみ初秋の木の下露にぬれて行くかも朝月の光の中にかたむける桔梗をいたみ秋山を行く朝月の光かぎらふ山上に秋草刈ると露にぬれたり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0036",
   "pid": "904885",
   "pages": [
    47
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "朝月の光の遠にほのうかむ秋山みつゝ鎌とげるかも遠岬の燈竿の灯の戀しきにあかつき露にぬれゆく秋山遠岬の燈竿の灯になげかへり秋草刈るとゆく曉の山遠岬の燈竿の灯は秋草をわが刈る瞳にうす赤きもよ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0037",
   "pid": "904885",
   "pages": [
    48
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "遠岬の燈竿守をおもひけり草刈る山のあかつきにして赤濁り遠海低し朝月の光かぎらふ山上にして遠海に赤き太陽の生るればわれを忘れぬ山上にして×紫蘇汁の冷えしをすすり初秋の山家に父の老いて行くかな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0038",
   "pid": "904885",
   "pages": [
    49
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "頸赤きほたるが秋の水草の葉うらを這へばなげかひにけり石走る垂水の上にうかみいでて岩魚の遊ぶ秋は來にけり朴の青き廣葉がひるがへりせまるが悲しくらき山窓黃に濁る大川口に沙魚つると我が子をおきて行けば悲しも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0039",
   "pid": "904885",
   "pages": [
    50
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "紅皿を久に忘れしわが妻の紅さし指を見てありにけりよち〳〵と庭を步めるせきれいのあら悲しもよ其のしろき腹初秋のまひるの厩乳に飢ゑし子馬の瞳のいた〳〵しさよ山皺の皺の一つに入りつ陽のあかるくさせば汝に心とぶ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0040",
   "pid": "904885",
   "pages": [
    51
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "むらがりて秋の鴉の來なく日の心悲しも子守しあれば干草の山より山に夕霧のわたれば末の子をおもひけりのろ〳〵と山より霧は這ひて來ぬ幼子いだき立てる夕戶に誰とまだ見覺えのなき面持し見つめてあるよ子のくろき瞳は",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0041",
   "pid": "904885",
   "pages": [
    52
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ひるの部屋秋の蠅とび乳呑兒のねたらぬ顏のうらさみしさよ穗を孕む青きすゝきの上にふる白日つよき光悲しも森かげの草にすわりて榛の實をむくときも吾子をおもひき一人もつ末の女の子をいたはりて紅の花さく山國にすむ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0042",
   "pid": "904885",
   "pages": [
    53
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "しら〳〵と蕎麥の花さく山國に女の子生れて百日を經たり夜の庭に山霧くれば子を抱きて早寢をすなり虫なくものをひよろ〳〵とおはぐろとんぼとびて行く水草に秋の夕陽の散れる茄子畑の番小屋の灯がうす闇にゆるゝを見つゝわれ歩み居り",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0043",
   "pid": "904885",
   "pages": [
    54
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夜はふかしわれとわがうつ拍子木に茄子畑守りは悲しからずや大搖れに空のみどりもゆれてけり野分の力天地にみつ一面にふき平めよ一面に野分の中の青き山々ころ〳〵と野分の中の草屋根をころがりおつる黃なる南瓜",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0044",
   "pid": "904885",
   "pages": [
    55
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "穗を孕む稻の葉末に夕露ののぼるを見つゝ汝をおもふなりふとかみし青き葡萄のすぱければ從妹をおもふ初秋の山祖母のやめる岩手の夕山のかげろへば母はうれひたまへり末摘花見てあれば悲し遠人の紅さし指をおもふならねど",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0045",
   "pid": "904885",
   "pages": [
    56
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕虹の山になびけばくしけづる從妹が髪をおもふなりけり青くるみもぎし我が掌のうす黄いに染みしを見るとかざす秋の陽間引菜をもて來て妻が與へ居る仔兎の箱に夕陽が黃なり山わらぢけさも素足にゆひつけてわれ行かんとす秋草の山",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0046",
   "pid": "904885",
   "pages": [
    57
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "赤々と夕陽はてれり牛飼が褌をほせる秋の河原に晝顏のさける河原に牛飼はふどしを洗ひ干してけるかも秋庭のやけ土の上を一つとぶ黃の山蜂のうなり悲しも×うまれたるあかんぼが爲めに我が掘れる黃蓮の黃なる根のまさびしや",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0047",
   "pid": "904885",
   "pages": [
    58
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あかんぼの泣き聲をきゝ眼をとぢてくりやのすみに黃蓮を煮る乳汁しらぬあかんぼにまづふくまする黃蓮の汁のうす黃なる色甘露ふるま夏の山のあかつきに生れし子かなし女なりけり抱く手にあかんぼねむり夏虫の夜ふかくなけば憂ひ居にけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0048",
   "pid": "904885",
   "pages": [
    59
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "かな〳〵と庭木になけばふところの子はぱつちりと眼をひらきけりわか竹の露ちるかげに吾子抱き河鹿の聲をきけば悲しも女の子一人しもてば水草のうす紫もあはれなりけり名付親遠きにもちて濃綠の國にことなく育ちゆく子よ二首みほ子が爲めに",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0049",
   "pid": "904885",
   "pages": [
    60
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "名付親遠きにありてうつしゑに一目見たしといひにけらずや金蓮花赤く咲きつゝ子の久に眼を病む夏はたけなはとなるかよわき子持てば悲しき親心木草の花のちるにつけても七つなる仲子が爲めに仔兎の小さき箱をわがつくるかな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0050",
   "pid": "904885",
   "pages": [
    61
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "金網の前に來りて仔兎の鼻うごかせばよろこべる子よ濃綠の草野を知らず耳ふせて古箱のすみにねむる仔兎水無月のまひるの山に靄ふればかつこうとなく鳥のさみしや高原の朝草露にうちぬれて鎌とげば鐵の匂の悲しや",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0051",
   "pid": "904885",
   "pages": [
    62
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "石竹の花さく路に東女も立たせて見ればやさしかりけり陽も知らず吐息悲しくひるがへる繁木が中の草の下葉よあへぎ〳〵赤き舌はく夏犬の悲しもよ土に橫たはりゐつ草原の木株の黃なる小さき巢に山蜂の子は育ちゆくかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0052",
   "pid": "904885",
   "pages": [
    63
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "草原の木株の黃なる巢をいでて山蜂とべば山も悲しきふと瞳をそらしゝ君はわが駒の赤き頭絡に見入るなりけり馬さへもいとひ見むかぬ山の邊のとりあしの花はあはれなりけり古庭の石上にいでて河鹿なく月明の夜は君のしのばゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0053",
   "pid": "904885",
   "pages": [
    64
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "石走しる水よりあくる曉に河鹿のなけば君のしのばゆ汝に心うごかぬまなし風忘れ此夕草はそよがざれども口ふりしまゝ別れ來し鄙の路しめらへる土の匂悲しも汝が街をそがひとなしていづるさへ悲しきくれを雨となりにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0054",
   "pid": "904885",
   "pages": [
    65
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山にゐて山の小鳥の名を知らず垂乳根の母の齡をえしらず黃に濁り春の陽暈の傾けばなんにも知らぬ女もなげかへり春の陽の暈するまひる眩暈すとみごもる妻は憂ひゐにけりみごもれる妻の乳房のおもきかも春の入り陽の黃に暈すれば",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0055",
   "pid": "904885",
   "pages": [
    66
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "芹つむと汝が白き手をひたすまで淺澤の水ぬるみたるかも燒枯れし木株にまじりおきな草紫にさく夕山を越ゆ燒枯れの木株のかげゆとび立ちしひばりも悲しひとりなりけり燒枯れし木株の中の一もとの芽をふく見れば心悲しも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0056",
   "pid": "904885",
   "pages": [
    67
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "妻がため春の深山に子安の木たづね入る日のうら悲しさよ子安の木たづねつかれて春山のかげになげきぬ妻みごもれば燒原を行けど野火見ず燒土の匂を知らず汝をおもへばかいたはりて行きぬ野燒の燒土の匂に耐へぬみごもれる妻",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0057",
   "pid": "904885",
   "pages": [
    68
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "もやしたる種籾の芽のうす青し八十八夜きたる山國みごもればものうげの瞳に種籾のもやしに妻の見入るあはれさみごもれる妻が乳房ゆ乳汁やゝに洩る日となりて春ふけにけりみごもれば物うきかもよくけかけてたすきはならず桑は芽ぶくに",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0058",
   "pid": "904885",
   "pages": [
    69
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "はしきやし妻みごもれば山桑をことしは一人いでて摘むかも妻子持ち春霧ふれる夜の木原憶良をおもひ行けば悲しも夜の山々春霧ふれば石女はさみしき乳房いだき寢るかも沙川の流の上を鳶一つ舞へり春の陽琥珀の如し×",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0059",
   "pid": "904885",
   "pages": [
    70
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "鶏は悲しき鳥よ蒼空を永久に忘れて地を歩める蒼空を永久に忘れし鳥として鶏よ汝が悲しき翅にはとりは春の朝陽に頸あげて高なけり飛ぶを忘れし鳥よ垂乳根の母なりければ刺の樹の楤の芽もつみてさゝげつるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0060",
   "pid": "904885",
   "pages": [
    71
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "垂乳根の母なりければまめやかに御肩もみつゝ夜をうまずけり垂乳根の母なりければ眉そりしあとの青きもいたましきかな春山のかげにうす黄の芽をふけるとりもとまらぬさみしき一樹楤の木は手もふれられずうす黄なる芽をなつかしみ立ちつくす山",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0061",
   "pid": "904885",
   "pages": [
    72
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "物洗ふみごもる妻の眼の前に柳の花はうす黃なるかも美女の彼乳兄弟久に來ず柳の黃なる花おちぬべし春木原雨しげければおもひいづ山がつが娘の彼乳兄弟乳兄弟の娘のなつかしき春の夜は青木の木ぬれ霞流るる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0062",
   "pid": "904885",
   "pages": [
    73
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "乳兄弟の娘の黑髪は匂ふらむ其扉の杏花を持つらむ心なくむしる春木の皮の香の悲しや神を孕むといふにみごもれる妻の憂ふる夕山の野火の火上に雉子なきにけり濁川の流を前に相槌のかぬぢがつまのうらわかさかな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0063",
   "pid": "904885",
   "pages": [
    74
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "忘れても金縷梅さける山越ゆなまんさくは黃にみだれさく花空斜に翅ならして高とべば小鳥となりて飛ばんとぞおもふいたづらのうす紫よ君が來ぬ鄙の長路のいたどりの芽よ鄙なれば父が羽織の假紐の紙紐も人は笑はざりけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0064",
   "pid": "904885",
   "pages": [
    75
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ぬぎすてし父がみぢかき古羽織白きもさみし紐の紙紐よ水色の山は悲しも馬盥をへだててのぞむ春のたそがれ×むらがりてあをじはとべど我が瞳あぐるにおもし春の燒原友が妻まだみごもらず如月や山國の水いただぬるまず",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0065",
   "pid": "904885",
   "pages": [
    76
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山人が太き烟管の火皿の火みつゝ夕ぐれつれ立ちにけりうすのろの男が下駄の太き緖のさみしや土手に夕陽がちれる待つといはゞ夜の向つ峰の走り火の火中も走り我れゆかんもの我が煙管の火皿の火よりやや赤く遠山やけぬ闇のかなたに",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0066",
   "pid": "904885",
   "pages": [
    77
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雪解する山のふもとの片くりの紫の花みに來じか君雪解する山裾にさく花なれば紫なれば悲しや片くり雪解する山越えて逢ひに來てくるる人はあらぬを片くりの花君戀しかぐらきむろの種芋の芽ののびて行く如月くれば",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0067",
   "pid": "904885",
   "pages": [
    78
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うづきまの犬の尻尾のうごけるを見おくる土手に夕陽は赤しむく犬の尾の渦卷がだんだんにひろごる如し土手の入りつ陽軒の上おぼつかなげに啼きてゐる黃雀の黄の口の可愛ゆや如月の山をそがひにまさびしく順禮は鉦たゝきて行くも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0068",
   "pid": "904885",
   "pages": [
    79
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "はだれ雪こゝは岩手の山つゞき燒原つづき黃なるわか草迷ひ入る夜闇の森の古道に青く光れる朽木悲しも雪解する山はさみしも背負ひゆく杉の苗木の匂悲しも路はたの家の寡婦の日髪はもその私生兒は襤褸につゝまれてあり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0069",
   "pid": "904885",
   "pages": [
    80
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "三人の田舍娘の立ち話山には午後の春の陽が赤しはしためはゐねむりゐたりあしおとをぬすみて家畜すぎゆきにけりこやし桶になふ與助の天秤のたゆ〳〵うごく畑の入りつ陽×うづくまり牛蒡を堀れば黒土の底に悲しく牛蒡ぞ匂ふ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0070",
   "pid": "904885",
   "pages": [
    81
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "眇なるわかき修路夫ほころびし古服を着てはたらけるかも山鼻をめぐりくれども修路夫の眇の顏が眸にのこれる一線を地平のはてに濃くゑがき黝める冬の遠海が見ゆ落葉樹の林を出でてぼつちりと月下にわれの小さくうごける",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0071",
   "pid": "904885",
   "pages": [
    82
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "田舍路の上をよこぎる電線になけるしととの灰白の腹×伯母が柩かきゆく山路立枯の白き一樹の眼にいたきかな高原の伯母をうづめし土饅頭めぐれる青きはじき竹はもみもごもれる妻が黑髪おも〳〵と夜の木枕にうちしめるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0072",
   "pid": "904885",
   "pages": [
    83
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "我が襯衣の釦をかゞる指さきのしろきが閨のくらき灯に浮く山の間赤く濁りて朝の陽は冬枯の木にかげろひにけりつきつめし心のはしにふれて來る昨日まで知らぬ蒼空の色思出ももたぬにあらぬ山人にこはあはたゞしき木の葉しぐれぞ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0073",
   "pid": "904885",
   "pages": [
    84
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "冬枯の林の中におぢ〳〵とさみしく立てる青の一樹よ炭がまの夜ごめの焚火冬枯の林をすきてうす青きかな水鳥の翅の下にうす光る冬川の流見れば悲しも草鞋の緖むすび直すとかゞまれる眼の前の冬の草の芽の青",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0074",
   "pid": "904885",
   "pages": [
    85
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "汝おもへば冬木の枝の宿り木の實の赤きにも淚ながれぬ×夜あらしに庭木の黃葉のとびつくし窓にさみしく赤き朝の陽茶の花は萠黃の布を張板にはる妻の前しら〳〵さくもおもひ屈し野路をいゆけば立枯の山百合の種子の夕風に飛ぶ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0075",
   "pid": "904885",
   "pages": [
    86
   ],
   "no": null,
   "maki": "大正三年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "苗床の霜よけ薦の霜とけず我が濁る瞳に朝の陽の赤したてかけし葛家のすみの稻扱の赤さびし齒に光る窓の陽小夜しぐれ彼もらはれぬ牛飼の一人娘はわびて寢るらむほのかにも汝がすむ山の黄に低し一株の茅のそよぐ彼方に",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0076",
   "pid": "904885",
   "pages": [
    87
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "冬枯の山をそがひに刈る茅の尾花の飛ぶも汝をしのばしむ大正二年",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0077",
   "pid": "904885",
   "pages": [
    88
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "我が簑を君にしかせてものがたる秋草の山のひるのこほろぎ簑ぬげばみのをこぼれて我が前の土にこぼるるくろき草の實",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0078",
   "pid": "904885",
   "pages": [
    89
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "めさむれば古き時計は午後四時にてとまれり秋のつめたき板敷あかつきの野澤の霧に簑ぬれていゆくわくごになく水鷄かな山葡萄畚にあまると告げやるもなほ山ずみをいとへるか汝此男のがるる秋の國しらずもだして山に青草をやく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0079",
   "pid": "904885",
   "pages": [
    90
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "縮緬の襦袢の袖を買ひやらんとばかりに妻を峻に老いしめぬこのまゝに別れていゆき再は來じとぞわれのいひもせざるに黃に濁りしづまんとする秋の陽を橫ぎりて飛ぶかけすの一むれ秋山に我がきり出だす海苔柴の若木の匂むねいたましむ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0080",
   "pid": "904885",
   "pages": [
    91
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "海苔柴のわか木の青葉我が扱けばかなしき匂せまる秋山ばらの實の赤くなるときまた來よと磐城少女はわれにいひしか旅人は路傍の家の軒につる黃の葉煙草の香にむせびけり燒飯の匂にひたり秋草の黃ばめる中に横たはるかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0081",
   "pid": "904885",
   "pages": [
    92
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雨來たる秋の磐城の山麓の木原のしろき立枯の上秋の蟲一人は母とふるさとに一人の吾子は父と旅寢に秋の風磐城の山を前にして汝をおもふとき飛ぶ心地する旅人の眼に悲しくも死火山の赤燒石の陽に光りたる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0082",
   "pid": "904885",
   "pages": [
    93
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うす暗き厩のすみにつながれし人喰馬の赤たゞれし眼秋山をそがひになして藤蔓の人喰馬の口籠をあむことしより一人寢をする子のために妻が縫ひたる小さき寢卷よ庭木の枝かなしなつかし幼な日の彼ぶらんこの繩ずれのあと",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0083",
   "pid": "904885",
   "pages": [
    94
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "なにげなくたぐる通草の蔓の末青き實のありさみしや秋山汝おもへばはた〳〵よりもかるやかに飛ばむとすなり秋草の山×自棄の涙河原うつぎの毒もてる實の色づけば流れいづるも汗あえて耕やす畑の土いきれ自棄の男のむねいたましむ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0084",
   "pid": "904885",
   "pages": [
    95
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "晝の雨葉廣かしはにふりいづれど此はした女はめざめざりけり我が妻が蠶飼つかれの瞳の色も夏桑の芽もさみしき七月木のうろの山蜂の巢に蜂の子の孵化るか森に黃なる陽のふるつかれては山畑添ひの青き木のかげにひる寢もむさぼりてけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0085",
   "pid": "904885",
   "pages": [
    96
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黑髪に散る山栗の花などもなつかしがりて君はわかれき天蓼の蔓をねぶりてよろこべる家畜も君を戀しがらする×馬醉木散る汝をおもひゆく春山に白くさみしく散りしきにけり自棄の涙おさへ得ぬ日を赤棟蛇杉菜のかげにいでて遊べる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0086",
   "pid": "904885",
   "pages": [
    97
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "拾ひあげし燒野の小さき燒石のあたゝかきにぞ淚ながるゝ掌に通草の花をのせし故おもひいだせる汝にあらねども汝をおもひ春山ゆけば悲しうも通草の花のさきつゞく路慈姑の芽青くさみしく瞳にうつる水田の畦をわかれ來ぬれば",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0087",
   "pid": "904885",
   "pages": [
    98
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "春雨にいたどりの芽のぬるゝにも汝をおもひて立ちつくす路すもゝさく四月は悲し人妻はかほそなる手に麥の雜草とる×青木原霞流る夜となればなきむせぶかや彼の梟は野火遠く走しるをながめ燒土の匂の中に立ちて涙す",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0088",
   "pid": "904885",
   "pages": [
    99
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "とび〳〵に燒野の小さき木のうれの芽をふける見て涙ながしき竹むらの中に家畜のなきがらをうづめむとおもふ竹の鳴る日を河淀に流れよりたる流れ木の上にかなしくなく川がらすきらはれて屠牛者が娘もらはれずわびすむ山にこぶし花ちる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0089",
   "pid": "904885",
   "pages": [
    100
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うづくまり春の木かげに山獨活の芽をほるときも君を忘れずさかりゐる子はよしわれをおもひつゝあはで死ぬらむ子のあれよかし一とびにとび越えて逢ひに行きたさのなげきの前に夜の山高しゆく舟のあとに一路の光るありなかぬ鷗のとびめぐる海",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0090",
   "pid": "904885",
   "pages": [
    101
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "とつぷりとくれゆく春の夕山に向ひて何もいはれぬなりけり荒野やく野火の煙の上になくひばりをきけば君のしのばゆおもはるゝ安さに居りて別れをばなげくに似たり汝が涙もむささびは夜な〳〵なきに來たるべし終のふしどぞ此野木のもと",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0091",
   "pid": "904885",
   "pages": [
    102
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ましぐらに青竹原に走り入る夜のけものゝ黃なる背の色川上の木かげの家に子を抱きわれまつらんぞ山のかなたに野平の冬木の上に赤たゞれ朝やけ雲の流れて悲しも母が前妻を叱りて物かげになぐさめてやる悲しき心",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0092",
   "pid": "904885",
   "pages": [
    103
   ],
   "no": null,
   "maki": "大正二年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "餘念なく籾摺唄を我が妻とうたひあへるもあはれなるかな石女と笑はるゝ娘がわびずみの路傍の家の壁の芋蔓冬川の流に添ひて川がらすなきゆくくれは君のしのばゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0093",
   "pid": "904885",
   "pages": [
    104
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "大正元年明治四十五年",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0094",
   "pid": "904885",
   "pages": [
    105
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "漆搔く男と行けば生うるしの悲しき匂せまる秋山蜱なく妻がわづかのあやまちを叱りし後の悔心かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0095",
   "pid": "904885",
   "pages": [
    106
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "幅せまき帶にしめかへ畑へゆく後姿の妻のあはれさ病室の前の椿の青き實のはじけて秋はたけなはをすぐ秋の雲名しらぬ山の頂にうごかず淚妻に流るゝ秋ゆくか山家の壁の芋蔓の薄黃なる葉のひるがへり散る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0096",
   "pid": "904885",
   "pages": [
    107
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "十月の日光のなかに我が肺のすごやかなるをよろこべる日よ山低う黃ばめる彼方遠海のほのかに白し十月のひる黃ばみたる山と山との間をゆく一すぢ川のうす青みたる×小さなるカバンをさげていでゝ行く後すがたを妻と見おくる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0097",
   "pid": "904885",
   "pages": [
    108
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "日暮るれば二人の子供の抱き寢る古蚊張をつる部屋の片すみ我が妻が青あみ笠の細ひもの苺もぐ手にそまる水無月莢嫩きさゝげをつめる妻が指青くそまるもうら悲しさよ水無月の梢の毛蟲蛾となりて飛ばむとするもあはれなるかな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0098",
   "pid": "904885",
   "pages": [
    109
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "餘念なく青鬼灯のからをむく子が橫顏にしめる宵の灯押しだまり我と妻とが見あげ居る青田の上の薄にごり空庭のすみはこべついばむ灰色のにはとりの雛の姿さびしや毒ふくむ河原うつぎの赤き實をなつかしみ見るさびしき夕",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0099",
   "pid": "904885",
   "pages": [
    110
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "彼橋はうれしかりしよ手かさむといはねどかせとのたまはねども（松島橋）＊＊＊子には子のわれにはわれの春來たる水色の山遠くけむりてうれしさのはてに君みき悲しさの行きつまるところまた君を見る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0100",
   "pid": "904885",
   "pages": [
    111
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ことしより學校へ行く子のためにはしめてつくる藁草履かなうらさみし少年の日の心もて父となる身が父とよばるゝ山國にすめば木の花草の花さき散るごとにうごく心か×いさかひて女同士が往來せぬ中を流るる冬の川かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0101",
   "pid": "904885",
   "pages": [
    112
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "母となり薄おしろいのたしなみも忘れしごとき妻のあはれさ古盆のさはし柿などうちもだし皮むきてゐる我が妻の顏次ぎの子もみかんの皮を一人にてむきうるほどになりし冬かな冬枯の桑の梢のからす瓜薄黃なるにもいたむ心か",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0102",
   "pid": "904885",
   "pages": [
    113
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あか〳〵と朝燒雲は冬枯の雜木林の上にうごかず薄みぞれ漆のはげし古椀のふせられてある朝の卓かなうら悲しわかき心も父となれば父の心になりて行くなど",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kumagai-takeo-904885-0103",
   "pid": "904885",
   "pages": [
    114
   ],
   "no": null,
   "maki": "大正元年明治四十五年",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "野火終著作權所有大正四年九月十五日印刷大正四年九月二十日發行（定價七十錢）著者　熊谷武雄東京府豐多摩郡大久保町西大久保二百一番地發行者　前田洋三東京市神田區美土代町二丁目一番地印刷者　白土幸力東京府豐多摩郡大久保町西大久保二百一番地發行所　白日社東京市神田區表神保町三番地發賣所　東京堂",
   "sachu": "",
   "poems": []
